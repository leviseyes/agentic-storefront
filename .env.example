# Copy this file to .dev.vars for Cloudflare local development.
# No keys are needed for the scripted demo and sample cart.
COMMERCE_MODE=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
IMAGE_MODEL=gpt-image-2
XAI_API_KEY=
GROK_VOICE_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_v4
ELEVENLABS_VOICE_ID=
ELEVENLABS_FEMALE_VOICE_ID=
# To connect your OWN store, set COMMERCE_MODE=shopify and map EVERY local variant ID.
# Product handles are configured in the merchant example. No Admin token is needed.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_VARIANT_MAP_JSON=
SHOPIFY_CHECKOUT_DOMAIN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
