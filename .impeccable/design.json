  "narrative": {
    "northStar": "The Warm Paper Storefront",
    "overview": "Agentic Storefront inherits a warm paper surface, brown controls, and self-hosted Manrope. Large, tightly spaced headings provide the visual emphasis; generous prose leading and restrained dividers keep the shopping conversation readable. The sample merchant Studio, guide Alex, and product Studio Mount are fictional content for this reusable starter.\n\nThe visual stage and conversation share one quiet frame. Product inspection, imagery, and cart information occupy the stage while the conversation retains its own space. Material comes from warm tonal surfaces and imagery rather than decorative interface effects.",
    "keyCharacteristics": [
      "Warm paper and brown action colors.",
      "One self-hosted variable type family with weight and scale doing the work.",
      "A product stage beside the conversation on desktop, stacked above it on mobile.",
      "Flat working surfaces, gently rounded controls, and explicit focus states."
    ],
    "rules": [
      {
        "name": "The Paper and Ink Rule",
        "body": "Use paper for the conversation and tint for working stages; reserve white for inputs and small product-image surfaces. Brown carries actionable emphasis.",
        "section": "colors"
      },
      {
        "name": "The Single Family Rule",
        "body": "Use Manrope throughout the storefront. Build hierarchy through the observed weight, size, and tracking relationships.",
        "section": "typography"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Keep the main panels flat. Reserve the existing ambient shadows for temporary floating surfaces.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the warm paper, brown accent, and Manrope relationship when adapting merchant content.",
      "Do keep the visual stage and conversation independently readable at desktop widths and stack them at the mobile breakpoint.",
      "Do keep icons as inline SVG controls, with accessible labels and visible keyboard focus.",
      "Do use tabular numerals for quantity, price, and totals.",
      "Do retain reduced-motion behavior and the mobile composer\u2019s readable text size."
    ],
    "donts": [
      "Don't replace the working panels with a grid of elevated cards.",
      "Don't use brown text alone to communicate selected controls; preserve the existing fill, underline, or pressed-state treatment.",
      "Don't introduce a second display family or all-caps heading system.",
      "Don't add decorative eyebrow labels above headings; progress counts and speaker names are functional labels, not heading decoration."
    ]
  }
}
