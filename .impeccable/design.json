  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "description": "Brown action used to start exploring or add a selected option.",
      "html": "<button class=\"ds-primary\">Start exploring <svg aria-hidden=\"true\" width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></button>",
      "css": ".ds-primary{font-family:\"Manrope Variable\",sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:48px;padding:12px 18px;border-radius:9px;font-size:13px;font-weight:650;line-height:1.4;cursor:pointer;border:0;background:var(--accent,#65523b);color:var(--white,#fff)}.ds-primary:hover{background:var(--accent-hover,#433523)}.ds-primary:focus-visible{outline:3px solid var(--accent,#65523b);outline-offset:4px}.ds-primary:disabled{opacity:.45;cursor:not-allowed}@media(max-width:760px){.ds-primary{min-height:46px;font-size:12px}}",
      "refersTo": "button-primary"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "description": "Quiet outlined action, also used by the empty cart.",
      "html": "<button class=\"ds-secondary\">Explore the collection <svg aria-hidden=\"true\" width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></button>",
      "css": ".ds-secondary{font-family:\"Manrope Variable\",sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:48px;padding:12px 18px;border-radius:9px;font-size:13px;font-weight:650;line-height:1.4;cursor:pointer;border:1px solid var(--line,#ded8cd);background:transparent;color:var(--ink,#292720)}.ds-secondary:hover{background:var(--tint,#eee8dd)}.ds-secondary:focus-visible{outline:3px solid var(--accent,#65523b);outline-offset:4px}.ds-secondary:disabled{opacity:.45;cursor:not-allowed}@media(max-width:760px){.ds-secondary{min-height:46px;font-size:12px}}",
      "refersTo": "button-secondary"
    },
    {
      "name": "Conversation Composer",
      "kind": "input",
      "description": "White composer; keyboard focus belongs to the textarea and send button.",
      "html": "<div class=\"ds-composer\"><textarea aria-label=\"Message Sam\" placeholder=\"Ask Sam about the products…\"></textarea><div class=\"ds-composer-actions\"><button class=\"ds-send\" aria-label=\"Send message\"><svg aria-hidden=\"true\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 19V5m-7 7 7-7 7 7\"/></svg></button></div></div>",
      "css": ".ds-composer{font-family:\"Manrope Variable\",sans-serif;background:var(--white,#fff);border:1px solid var(--line,#ded8cd);border-radius:16px;padding:14px}.ds-composer textarea{font-family:\"Manrope Variable\",sans-serif;display:block;width:100%;resize:none;background:transparent;border:0;color:var(--ink,#292720);font-size:15px;font-weight:450;line-height:1.6;height:55px;padding:0 4px;caret-color:var(--accent,#65523b)}.ds-composer textarea::placeholder{color:var(--muted,#686257)}.ds-composer-actions{display:flex;align-items:center;gap:8px;justify-content:flex-end}.ds-send{height:44px;width:44px;border-radius:10px;border:0;background:var(--accent,#65523b);color:var(--white,#fff);display:grid;place-items:center;cursor:pointer}.ds-composer textarea:focus-visible{outline:3px solid var(--accent,#65523b);outline-offset:4px}.ds-send:focus-visible{outline:3px solid var(--accent,#65523b);outline-offset:4px}.ds-send:disabled{opacity:.45;cursor:not-allowed}@media(max-width:760px){.ds-composer{padding:10px}.ds-composer textarea{font-size:16px;height:48px}.ds-send{height:40px;width:40px}}",
      "refersTo": "composer"
    },
    {
      "name": "Suggestion Chip",
      "kind": "chip",
      "description": "Compact conversational shortcut with an outlined resting state.",
      "html": "<button class=\"ds-suggestion\">Compare products <svg aria-hidden=\"true\" width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></button>",
      "css": ".ds-suggestion{font-family:\"Manrope Variable\",sans-serif;font-weight:450;display:flex;align-items:center;gap:7px;padding:8px 10px;border:1px solid var(--line,#ded8cd);border-radius:8px;background:transparent;color:var(--ink,#292720);font-size:11px;line-height:1.6;min-height:36px;max-width:100%;text-align:left;cursor:pointer}.ds-suggestion:hover{background:var(--tint,#eee8dd)}.ds-suggestion:focus-visible{outline:3px solid var(--accent,#65523b);outline-offset:4px}.ds-suggestion:disabled{opacity:.45;cursor:not-allowed}",
      "refersTo": "suggestion-chip"
    },
    {
      "name": "User Message",
      "kind": "card",
      "description": "Content-sized tinted conversation bubble, aligned to the right.",
      "html": "<article class=\"ds-user\"><span>You</span><p>Compare the coffee</p></article>",
      "css": ".ds-user{font-family:\"Manrope Variable\",sans-serif;font-weight:450;background:var(--tint,#eee8dd);color:var(--ink,#292720);border-radius:14px;padding:14px 18px;max-width:85%;width:fit-content;margin-left:auto}.ds-user span{font-size:11px;font-weight:750;color:var(--accent,#65523b)}.ds-user p{margin:8px 0 10px;font-size:15px;line-height:1.85;white-space:pre-wrap;overflow-wrap:anywhere}@media(max-width:760px){.ds-user p{font-size:14px;line-height:1.8}}",
      "refersTo": "user-message"
    },
    {
      "name": "Cart Navigation",
      "kind": "nav",
      "description": "Outlined header cart control; on mobile it reveals the cart stage and hides its text.",
      "html": "<nav aria-label=\"Shopping\"><button class=\"ds-cart\" aria-label=\"Open cart, 2 items\"><svg aria-hidden=\"true\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"m6 3-3 4v14h18V7l-3-4ZM3 7h18M8 11a4 4 0 0 0 8 0\"/></svg><span>Cart</span><b>2</b></button></nav>",
      "css": ".ds-cart{font-family:\"Manrope Variable\",sans-serif;display:flex;align-items:center;gap:9px;border:1px solid var(--line,#ded8cd);border-radius:10px;padding:10px 14px;font-size:13px;font-weight:650;line-height:1.6;background:transparent;color:var(--ink,#292720);cursor:pointer}.ds-cart b{display:grid;place-items:center;min-width:22px;height:22px;padding:0 5px;border-radius:50%;background:var(--accent,#65523b);color:var(--white,#fff);font-size:11px;font-variant-numeric:tabular-nums}.ds-cart:focus-visible{outline:3px solid var(--accent,#65523b);outline-offset:4px}@media(max-width:760px){.ds-cart{padding:8px 9px;gap:6px;font-size:11px}.ds-cart>span{display:none}}",
      "refersTo": "cart-navigation"
    },
    {
      "name": "Product Options",
      "kind": "custom",
      "description": "Wrapped option choices show title, price, availability, and a reinforced pressed state.",
      "html": "<div class=\"ds-options\" role=\"group\" aria-label=\"Morning Coffee options\"><button aria-pressed=\"true\">Whole bean<span>$16.00</span></button><button aria-pressed=\"false\">Ground<span>$16.00 · Unavailable</span></button></div>",
      "css": ".ds-options{display:flex;flex-wrap:wrap;gap:8px}.ds-options button{font-family:\"Manrope Variable\",sans-serif;border:1px solid #bbae98;border-radius:9px;padding:10px 14px;text-align:left;flex:1;min-width:100px;font-size:13px;font-weight:450;line-height:1.6;background:transparent;color:var(--ink,#292720);cursor:pointer}.ds-options button span{display:block;margin-top:5px;color:var(--muted,#686257);font-size:11px}.ds-options button[aria-pressed=true]{background:var(--paper,#f7f4ee);border-color:var(--accent,#65523b);box-shadow:inset 0 -2px var(--accent,#65523b)}.ds-options button:focus-visible{outline:3px solid var(--accent,#65523b);outline-offset:4px}.ds-options button:disabled{opacity:.45;cursor:not-allowed}@media(max-width:760px){.ds-options button{font-size:12px}}",
      "refersTo": "variant-option"
    },
    {
      "name": "Collection Row",
      "kind": "card",
      "description": "Flat product row with image, description, starting price, and a navigation arrow.",
      "html": "<button class=\"ds-collection\"><svg class=\"ds-coffee\" role=\"img\" aria-label=\"Illustration of a fictional coffee bag\" width=\"132\" height=\"132\" viewBox=\"0 0 132 132\"><path fill=\"#b39a74\" d=\"M35 15h62l9 104H26z\"/><path fill=\"#75664d\" d=\"M34 27h64v4H34z\"/><path fill=\"#f7f4ee\" d=\"M42 54h48v39H42z\"/><ellipse fill=\"#65523b\" cx=\"66\" cy=\"74\" rx=\"9\" ry=\"13\" transform=\"rotate(15 66 74)\"/><path stroke=\"#f7f4ee\" d=\"m69 63-6 22\"/></svg><span><strong>Morning Coffee</strong><span>A fictional medium-roast coffee for exploring product options.</span><small>From $16.00</small></span><svg aria-hidden=\"true\" width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></button>",
      "css": ".ds-collection{font-family:\"Manrope Variable\",sans-serif;display:flex;align-items:center;gap:22px;width:100%;text-align:left;padding:24px 0;border:0;border-top:1px solid #cec4b4;background:transparent;color:var(--ink,#292720);cursor:pointer}.ds-coffee{width:132px;height:132px;border-radius:12px;flex-shrink:0}.ds-collection>span{flex:1;min-width:0}.ds-collection strong{display:block;font-size:21px;font-weight:700;letter-spacing:-.025em;line-height:1.3}.ds-collection>span>span{display:block;font-size:13px;line-height:1.7;color:var(--muted,#686257);margin:10px 0}.ds-collection small{font-size:13px;font-weight:700;color:var(--accent,#65523b)}.ds-collection:focus-visible{outline:3px solid var(--accent,#65523b);outline-offset:4px}.ds-collection:disabled{opacity:.45;cursor:not-allowed}@media(max-width:1100px){.ds-collection{gap:16px}.ds-coffee{width:100px;height:100px}.ds-collection strong{font-size:19px}}@media(max-width:760px){.ds-collection{padding:18px 0}.ds-coffee{width:86px;height:86px}.ds-collection strong{font-size:18px}.ds-collection>span>span{font-size:12px;margin:6px 0}.ds-collection small{font-size:12px}}",
      "refersTo": "collection-row"
    },
    {
      "name": "Comparison Table",
      "kind": "custom",
      "description": "Ruled comparison preserves merchant fact labels and scrolls horizontally when needed.",
      "html": "<div class=\"ds-comparison\"><table><thead><tr><th scope=\"col\">Compare</th><th scope=\"col\">Whole bean</th><th scope=\"col\">Ground</th></tr></thead><tbody><tr><th scope=\"row\">Price</th><td>$16.00</td><td>$16.00</td></tr><tr><th scope=\"row\">Roast</th><td>Medium</td><td>Medium</td></tr><tr><th scope=\"row\">Availability</th><td>Available</td><td>Unavailable</td></tr><tr><th scope=\"row\"><span class=\"ds-hidden\">Continue</span></th><td><button>Explore <svg aria-hidden=\"true\" width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></button></td><td><button>Explore <svg aria-hidden=\"true\" width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></button></td></tr></tbody></table></div>",
      "css": ".ds-comparison{overflow-x:auto;scrollbar-width:thin;scrollbar-color:#b9ad99 transparent;color:var(--ink,#292720)}.ds-comparison table{font-family:\"Manrope Variable\",sans-serif;width:100%;border-collapse:collapse;text-align:left;font-size:12px;line-height:1.7}.ds-comparison th,.ds-comparison td{padding:16px 12px;border-bottom:1px solid #cfc5b6;vertical-align:top;min-width:115px}.ds-comparison th:first-child{padding-left:0;min-width:85px}.ds-comparison th{font-weight:650}.ds-comparison thead th{font-size:17px}.ds-comparison button{font-family:\"Manrope Variable\",sans-serif;display:inline-flex;align-items:center;gap:6px;min-height:30px;font-size:12px;color:var(--accent,#65523b);text-decoration:underline;text-underline-offset:4px;border:0;background:transparent;cursor:pointer}.ds-comparison button:hover{color:var(--accent-hover,#433523)}.ds-comparison button:focus-visible{outline:3px solid var(--accent,#65523b);outline-offset:4px}.ds-hidden{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}@media(max-width:760px){.ds-comparison th,.ds-comparison td{padding:12px 9px;min-width:110px}.ds-comparison thead th{font-size:15px}}"
    },
    {
      "name": "Cart Quantity Stepper",
      "kind": "custom",
      "description": "Separate outlined decrement/increment buttons and an underlined remove action for each cart line.",
      "html": "<div class=\"ds-quantity\"><button aria-label=\"Remove one Morning Coffee Whole bean\"><svg aria-hidden=\"true\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M5 12h14\"/></svg></button><output aria-label=\"Morning Coffee Whole bean quantity\">2</output><button aria-label=\"Add one Morning Coffee Whole bean\"><svg aria-hidden=\"true\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M5 12h14M12 5v14\"/></svg></button><button class=\"ds-remove\">Remove</button></div>",
      "css": ".ds-quantity{font-family:\"Manrope Variable\",sans-serif;display:flex;align-items:center;gap:6px;margin-top:12px;color:var(--ink,#292720)}.ds-quantity button:not(.ds-remove){display:grid;place-items:center;width:34px;height:34px;border:1px solid #bbad97;border-radius:7px;background:transparent;color:inherit;cursor:pointer}.ds-quantity output{min-width:30px;text-align:center;font-variant-numeric:tabular-nums;font-weight:650;font-size:13px}.ds-remove{font-family:\"Manrope Variable\",sans-serif;margin-left:auto;display:inline-flex;align-items:center;gap:6px;min-height:30px;font-size:12px;font-weight:450;color:var(--accent,#65523b);text-decoration:underline;text-underline-offset:4px;border:0;background:transparent;cursor:pointer}.ds-remove:hover{color:var(--accent-hover,#433523)}.ds-quantity button:focus-visible{outline:3px solid var(--accent,#65523b);outline-offset:4px}.ds-quantity button:disabled{opacity:.45;cursor:not-allowed}",
      "refersTo": "quantity-button"
    }
  ],
  "narrative": {
    "northStar": "The Warm Paper Storefront",
    "overview": "Agentic Storefront inherits a warm paper surface, brown controls, and self-hosted Manrope. Large, tightly spaced headings provide the visual emphasis; generous prose leading and restrained dividers keep the shopping conversation readable. Fieldwork (outdoor goods, guided by Alex) and Daybreak (coffee, guided by Sam) are fictional merchant examples of the same reusable interface.\n\nThe visual stage and conversation share one quiet frame. Collections, product options, comparisons, and multi-item carts occupy the stage while the conversation retains its own space. Merchant imagery and content can change across categories; material comes from warm tonal surfaces and imagery rather than decorative interface effects. The default experience is a labeled scripted demo; optional voice, photo tools, video, and live commerce appear only when configured.",
    "keyCharacteristics": [
      "Warm paper and brown action colors.",
      "One self-hosted variable type family with weight and scale doing the work.",
      "A product stage beside the conversation on desktop, stacked above it on mobile.",
      "Flat working surfaces, gently rounded controls, and explicit focus states."
    ],
    "rules": [
      {
        "name": "The Paper and Ink Rule",
        "body": "Use paper for the conversation and tint for working stages; reserve white for inputs. Brown carries actionable emphasis.",
        "section": "colors"
      },
      {
        "name": "The Single Family Rule",
        "body": "Use Manrope throughout the storefront. Build hierarchy through the observed weight, size, and tracking relationships.",
        "section": "typography"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Keep the main panels flat. Reserve the existing ambient shadows for temporary floating surfaces.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the warm paper, brown accent, and Manrope relationship when adapting merchant content.",
      "Do keep the visual stage and conversation independently readable at desktop widths and stack them at the mobile breakpoint.",
      "Do keep icons as inline SVG controls, with accessible labels and visible keyboard focus.",
      "Do use tabular numerals for quantities and totals where implemented.",
      "Do retain reduced-motion behavior and the mobile composer’s readable text size.",
      "Do keep fictional product, scripted-guide, availability, and demo-checkout labels visible where the corresponding state requires them."
    ],
    "donts": [
      "Don't replace the working panels with a grid of elevated cards.",
      "Don't use brown text alone to communicate selected controls; preserve the existing fill, underline, or pressed-state treatment.",
      "Don't introduce a second display family or all-caps heading system.",
      "Don't add decorative eyebrow labels above headings; progress counts and speaker names are functional labels, not heading decoration."
    ]
  }
}
