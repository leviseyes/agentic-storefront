{
  "name": "agentic-storefront",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply agentic-storefront --local",
    "check:public": "node scripts/check-public.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.554.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@fontsource-variable/manrope": "^5.2.8",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "5.20261022.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "wrangler": "4.152.0",
    "@types/three": "0.186.0"
  },
  "type": "module",
  "description": "A conversation-first storefront with live voice, visual tools, and Shopify cart actions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/leviseyes/agentic-storefront.git"
  },
  "overrides": {}
}
